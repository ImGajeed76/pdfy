    "svelte": "^5.55.5",
    "svelte-check": "^4.4.7",
    "svelte-eslint-parser": "^1.6.0",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
